# Set default behavior to automatically normalize line endings
* text=auto eol=lf

# Explicitly ensure source code, configs, and built assets always use LF
*.go text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.svg text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.sh text eol=lf
Dockerfile* text eol=lf
web/dist/* text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.exe binary
*.zip binary
*.tar.gz binary
