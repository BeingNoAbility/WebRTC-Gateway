# ==============================================================================
# Dockerfile.server - Zero-Client WebRTC P2P Integrated Server
#
# Combines:
# 1. Web Portal static assets (HTML5, Service Worker, Virtualization Patches)
# 2. WebSocket Signaling & SDP/ICE Relay Broker
#
# Default Port: 8888 (Web Portal: http://<ip>:8888/ | Signaling: ws://<ip>:8888/ws)
# Supports Native HTTPS/TLS (:443) via TLS_AUTO or custom TLS_CERT / TLS_KEY.
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Build Web Portal Frontend
# ------------------------------------------------------------------------------
FROM node:20-alpine AS web-builder
WORKDIR /build/web

COPY web/package*.json ./
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi

COPY web/ ./
RUN node esbuild.config.mjs

# ------------------------------------------------------------------------------
# Stage 2: Build Go Integrated Server (Signal + Embedded Portal)
# ------------------------------------------------------------------------------
FROM golang:alpine AS server-builder
WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY pkg/ ./pkg/
COPY cmd/ ./cmd/
COPY --from=web-builder /build/web/dist ./web/dist
COPY web/assets.go ./web/assets.go

# Multi-arch compatible build (uses builder native arch)
RUN CGO_ENABLED=0 GOOS=linux go build \
    -trimpath \
    -ldflags="-s -w -buildid=" \
    -o /build/server ./cmd/signal

# ------------------------------------------------------------------------------
# Stage 3: Minimal Production Image
# ------------------------------------------------------------------------------
FROM alpine:3.20

RUN apk add --no-cache ca-certificates tzdata libcap-setcap && \
    addgroup -g 10001 -S appgroup && \
    adduser -u 10001 -S appuser -G appgroup -H -D

WORKDIR /app
COPY --from=server-builder /build/server /app/server

# Grant cap_net_bind_service so unprivileged user can bind to privileged ports (<1024, e.g. :443, :80)
RUN setcap 'cap_net_bind_service=+ep' /app/server && \
    apk del libcap-setcap && \
    chown -R appuser:appgroup /app && \
    chmod 0755 /app /app/server

# Default environment variables
ENV ADDR=:8888 \
    SIGNAL_SECRET="" \
    TLS_AUTO=false \
    TLS_CERT="" \
    TLS_KEY="" \
    STATIC_DIR="" \
    MAX_IP_CONNS=64 \
    TRUSTED_PROXIES="" \
    METRICS_ADDR="" \
    CONFIG_FILE=""

EXPOSE 8888 443

# Drop root privileges by default (UID 10001: appuser, GID 10001: appgroup)
# Fully compatible with arbitrary --user <uid>:<gid> specifications at runtime.
USER 10001:10001

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD /app/server -health || exit 1

ENTRYPOINT ["/app/server"]
